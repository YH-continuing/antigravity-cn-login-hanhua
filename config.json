{
  "fake_ip": {
    "cidr": "198.18.0.0/15",
    "enabled": true
  },
  "_version": "antigravity-cn-no-tun",
  "_comment": "Antigravity 中国大陆 No-TUN 一键方案。默认代理 127.0.0.1:7897(SOCKS5)。如果您的代理端口不同，只需修改下面的 proxy.port。",
  "traffic_logging": false,
  "target_processes": [
    "language_server_windows",
    "language_server.exe",
    "antigravity-ide",
    "Antigravity.exe",
    "Antigravity IDE.exe",
    "node.exe"
  ],
  "proxy_rules": {
    "allowed_ports": [
      80,
      443
    ],
    "udp_fallback": "block",
    "ipv6_mode": "proxy",
    "routing": {
      "rules": [],
      "use_default_private": true,
      "default_action": "proxy",
      "enabled": true,
      "priority_mode": "order"
    },
    "udp_mode": "block",
    "dns_mode": "direct"
  },
  "child_injection_mode": "filtered",
  "timeout": {
    "recv": 5000,
    "connect": 5000,
    "send": 5000
  },
  "log_level": "info",
  "child_injection": true,
  "proxy": {
    "port": 7897,
    "type": "socks5",
    "host": "127.0.0.1"
  },
  "child_injection_exclude": []
}
